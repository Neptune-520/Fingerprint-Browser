{
  "name": "fingerprint-browser",
  "version": "2.0.5",
  "description": "Multi-Profile Isolated Fingerprint Browser System built with Electron 3x, Vue 3, and Tailwind CSS",
  "author": "Fingerprint Browser Team",
  "main": "main/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron . --dev",
    "start": "electron . --dev",
    "pack:win": "vite build && electron-builder --win nsis portable --publish never",
    "pack:mac": "vite build && electron-builder --mac dmg zip --publish never",
    "pack": "npm run pack:win",
    "dist": "npm run pack:win",
    "pack:exe": "node scripts/build-exe.js",
    "push:github": "node scripts/push-github.js",
    "release:organize": "node scripts/prepare-release-folder.js"
  },
  "build": {
    "appId": "com.fingerprint.browser",
    "productName": "FingerprintBrowser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "指纹浏览器",
      "uninstallDisplayName": "指纹浏览器 卸载程序"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Neptune-520",
        "repo": "Fingerprint-Browser"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0"
  }
}